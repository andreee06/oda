{
  "name": "oda",
  "private": true,
  "version": "0.1.0",
  "description": "self-hosted discord-ish chat for me and my friends",
  "author": "Andre Rasi",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @oda/server\" \"npm run dev -w @oda/client\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true
  }
}
