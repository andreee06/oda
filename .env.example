# --- server ---
PORT=3001
DATABASE_URL=postgresql://oda:oda-dev-only-change-me@localhost:5432/oda

# --- minio (S3-compatible media storage) ---
MINIO_ROOT_USER=oda
MINIO_ROOT_PASSWORD=oda-dev-only-change-me
MINIO_BUCKET=oda-media
MINIO_ENDPOINT=http://localhost:9000

# --- livekit (dev-mode defaults; replace before real hosting) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- tenor (slice 2) ---
TENOR_API_KEY=
