// Oda data model — reviewed & approved 2026-08-14 (SPEC.md ask-first gate).
// Conventions: cuid ids, snake_case plural tables via @@map, String channel type
// (validated by zod in @oda/shared — avoids enum migrations when voice lands).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(cuid())
  username       String        @unique
  displayName    String
  passwordHash   String // argon2id — never leaves the server
  avatarUrl      String?
  createdAt      DateTime      @default(now())
  sessions       Session[]
  memberships    ServerMember[]
  messages       Message[]
  createdInvites Invite[]      @relation("InviteCreator")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique // opaque, 256-bit random
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model Invite {
  code      String    @id // e.g. "oda-x7k2p9"
  creatorId String
  creator   User      @relation("InviteCreator", fields: [creatorId], references: [id])
  // null = legacy account invite (register joins the oldest server);
  // set = invite link bound to one specific server (slice 3)
  serverId  String?
  server    Server?   @relation(fields: [serverId], references: [id])
  maxUses   Int       @default(1)
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([serverId])
  @@map("invites")
}

model Server {
  id        String         @id @default(cuid())
  name      String
  iconUrl   String?
  ownerId   String
  createdAt DateTime       @default(now())
  channels  Channel[]
  members   ServerMember[]
  emojis    Emoji[]
  invites   Invite[]

  @@map("servers")
}

model ServerMember {
  userId   String
  serverId String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([userId, serverId])
  @@map("server_members")
}

model Emoji {
  id         String   @id @default(cuid())
  serverId   String
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name       String // shortcode without colons, e.g. "pepelaugh"
  imageUrl   String // /media/... path from /api/uploads
  uploaderId String
  createdAt  DateTime @default(now())

  @@unique([serverId, name])
  @@map("emojis")
}

model Channel {
  id        String    @id @default(cuid())
  serverId  String
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name      String
  type      String // "text" | "voice" — zod-validated at the boundary
  createdAt DateTime  @default(now())
  messages  Message[]

  @@map("channels")
}

model Message {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  content     String
  attachments Json? // [{ url }] — uploaded files via /api/uploads
  embeds      Json? // [{ url, title, description, imageUrl }] — OG unfurl results
  editedAt    DateTime?
  createdAt   DateTime @default(now())

  @@index([channelId, createdAt]) // cursor-pagination hot path
  @@map("messages")
}
